{
  "name": "@mrg-keystone/cli",
  "version": "0.1.33",
  "exports": "./src/bootstrap.ts",
  "tasks": {
    "keystone": "deno run -A src/bootstrap.ts",
    "deploy": "deno run -A deploy/index.ts"
  },
  "imports": {
    "#cliffy/command": "jsr:@cliffy/command@1.0.0-rc.7",
    "#cliffy/command/completions": "jsr:@cliffy/command@1.0.0-rc.7/completions",
    "#cliffy/prompt": "jsr:@cliffy/prompt@1.0.0-rc.7",
    "#class-validator": "npm:class-validator@0.14.1",
    "#class-transformer": "npm:class-transformer@0.5.1",
    "@deploy/": "./src/deploy/",
    "@dev/": "./src/dev/",
    "@env/": "./src/env/",
    "@external/": "./src/external/",
    "@open/": "./src/open/",
    "@plan/": "./src/plan/",
    "@shared/": "./src/shared/",
    "@update/": "./src/update/",
    "@workspace/": "./src/workspace/",
    "@planner/": "../planner/src/"
  },
  "compilerOptions": {
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictPropertyInitialization": false
  }
}
